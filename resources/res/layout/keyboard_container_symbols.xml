        <com.arizona.common.ui.KeyboardButton android:id="@+id/colon_button_key" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1" app:hasBackground="true" app:textKey=":"/>
        <Space android:layout_gravity="center" android:layout_width="7dp" android:layout_height="1dp"/>
        <com.arizona.common.ui.KeyboardButton android:id="@+id/semicolon_button_key" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1" app:hasBackground="true" app:textKey=";"/>
        <Space android:layout_gravity="center" android:layout_width="7dp" android:layout_height="1dp"/>
        <com.arizona.common.ui.KeyboardButton android:id="@+id/exclamation_point_button_key" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1" app:hasBackground="true" app:textKey="!"/>
        <Space android:layout_gravity="center" android:layout_width="7dp" android:layout_height="1dp"/>
        <com.arizona.common.ui.KeyboardButton android:id="@+id/question_mark_button_key" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1" app:hasBackground="true" app:textKey="?"/>
