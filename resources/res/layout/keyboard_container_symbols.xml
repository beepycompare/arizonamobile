    <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_weight="1">
        <Space android:layout_gravity="center" android:layout_width="match_parent" android:layout_height="1dp" android:layout_weight="1"/>
        <com.arizona.common.ui.KeyboardButton android:id="@+id/other_symbols_button_key" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1" app:hasSymbolBackground="true" app:textKey="#+="/>
        <Space android:layout_gravity="center" android:layout_width="7dp" android:layout_height="1dp"/>
        <com.arizona.common.ui.KeyboardButton android:id="@+id/at_button_key" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1" app:hasBackground="true" app:textKey="@"/>
